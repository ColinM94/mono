{
  "description": "Base configuration for all packages.",
  "compilerOptions": {
    /* Build */
    "noEmit": true,

    /* Language & Environment */
    "target": "esnext",
    "lib": ["ESNext", "DOM"],

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,

    /* Type Checking */
    "strict": true,
    "exactOptionalPropertyTypes": false, // TODO: re-enable this
    "noUncheckedIndexedAccess": false, // TODO: re-enable this
    "noImplicitReturns": false, // TODO: re-enable this
    "noImplicitOverride": true,

    /* Code Quality */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "erasableSyntaxOnly": true,

    /* Performance */
    "skipLibCheck": true
  },
  "include": ["global.d.ts"]
}
